<Window x:Class="AudioParsing.Win.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="620" Height="920"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.Resources>
      <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="FormField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
    </Grid.Resources>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="Настройки"
                 FontSize="20" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBlock Text="Параметры применяются к следующему запуску обработки"
                 FontSize="12"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Validation message (visible only when ValidationMessage is non-null) -->
    <Border Grid.Row="1"
            Background="{StaticResource ErrorSubtleBrush}"
            BorderBrush="{StaticResource ErrorBrush}"
            BorderThickness="1"
            CornerRadius="6" Padding="10,8"
            Margin="0,0,0,16"
            Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVis}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="⚠" FontSize="14"
                   Foreground="{StaticResource ErrorBrush}"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Text="{Binding ValidationMessage}"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Ffmpeg Path -->
    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Путь к ffmpeg" Style="{StaticResource FormLabel}"/>
      <TextBox Grid.Column="1"
               Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,0,8,0"
               Style="{StaticResource FormField}"/>
      <Button Grid.Column="2"
              Content="Обзор…"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding BrowseFfmpegCommand}"
              VerticalAlignment="Center"/>
    </Grid>

    <!-- Transcription backend -->
    <Grid Grid.Row="3" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Движок распознавания" Style="{StaticResource FormLabel}"/>
      <ComboBox Grid.Column="1"
                SelectedValue="{Binding TranscriptionBackend, UpdateSourceTrigger=PropertyChanged}"
                SelectedValuePath="Tag"
                VerticalAlignment="Center">
        <ComboBoxItem Tag="External">
          <TextBlock Text="Внешний (RouterAI Whisper)"/>
        </ComboBoxItem>
        <ComboBoxItem Tag="Local">
          <TextBlock Text="Локальный (GigaAM-v3)"/>
        </ComboBoxItem>
      </ComboBox>
    </Grid>

    <!-- Summarization backend -->
    <Grid Grid.Row="4" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Движок суммаризации" Style="{StaticResource FormLabel}"/>
      <ComboBox Grid.Column="1"
                SelectedValue="{Binding SummaryBackend, UpdateSourceTrigger=PropertyChanged}"
                SelectedValuePath="Tag"
                VerticalAlignment="Center">
        <ComboBoxItem Tag="External">
          <TextBlock Text="Внешний (RouterAI luna)"/>
        </ComboBoxItem>
        <ComboBoxItem Tag="Local">
          <TextBlock Text="Локальный (GigaChat GGUF)"/>
        </ComboBoxItem>
      </ComboBox>
    </Grid>

    <!-- API key guidance: required only when a stage is External -->
    <TextBlock Grid.Row="5" Margin="188,0,0,12"
               Text="Внешние движки используют RouterAI и требуют ANTHROPIC_AUTH_TOKEN. Пара «Локальный + Локальный» работает без сети."
               FontSize="11"
               Foreground="{StaticResource TextSecondaryBrush}"
               TextWrapping="Wrap"/>

    <!-- Language -->
    <Grid Grid.Row="6" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Язык (ru, auto)" Style="{StaticResource FormLabel}"/>
      <TextBox Grid.Column="1"
               Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource FormField}"/>
    </Grid>

    <!-- Transcription Model -->
    <Grid Grid.Row="7" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Модель транскрипции" Style="{StaticResource FormLabel}"/>
      <TextBox Grid.Column="1"
               Text="{Binding TranscriptionModel, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource FormField}"/>
    </Grid>

    <!-- Summary Model -->
    <Grid Grid.Row="8" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Модель суммаризации" Style="{StaticResource FormLabel}"/>
      <TextBox Grid.Column="1"
               Text="{Binding SummaryModel, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource FormField}"/>
    </Grid>

    <!-- GigaChat GGUF file -->
    <Grid Grid.Row="9" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Файл модели GigaChat" Style="{StaticResource FormLabel}"/>
      <TextBox Grid.Column="1"
               Text="{Binding GigaChatGgufPath, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,0,8,0"
               Style="{StaticResource FormField}"/>
      <Button Grid.Column="2"
              Content="Обзор…"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding BrowseGigaChatModelCommand}"
              Margin="0,0,8,0"
              VerticalAlignment="Center"/>
      <Button Grid.Column="3"
              Content="Скачать…"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding DownloadGigaChatModelCommand}"
              VerticalAlignment="Center"/>
    </Grid>

    <!-- GigaChat context size -->
    <Grid Grid.Row="10" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Контекст GigaChat" Style="{StaticResource FormLabel}"/>
      <TextBox Grid.Column="1"
               Text="{Binding GigaChatContextSize, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource FormField}"/>
    </Grid>

    <!-- GigaChat GPU layers -->
    <Grid Grid.Row="11" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Слои GPU (0 = CPU)" Style="{StaticResource FormLabel}"/>
      <TextBox Grid.Column="1"
               Text="{Binding GigaChatGpuLayerCount, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource FormField}"/>
    </Grid>

    <!-- GigaAM model directory -->
    <Grid Grid.Row="12" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Каталог модели GigaAM" Style="{StaticResource FormLabel}"/>
      <TextBox Grid.Column="1"
               Text="{Binding GigaAmModelPath, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,0,8,0"
               Style="{StaticResource FormField}"/>
      <Button Grid.Column="2"
              Content="Обзор…"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding BrowseGigaAmModelCommand}"
              Margin="0,0,8,0"
              VerticalAlignment="Center"/>
      <Button Grid.Column="3"
              Content="Скачать…"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding DownloadGigaAmModelCommand}"
              VerticalAlignment="Center"/>
    </Grid>

    <!-- GigaAM file names -->
    <Grid Grid.Row="13" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Файл энкодера" Style="{StaticResource FormLabel}"/>
      <TextBox Grid.Column="1"
               Text="{Binding GigaAmEncoderFileName, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource FormField}"/>
    </Grid>

    <Grid Grid.Row="14" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Файл декодера" Style="{StaticResource FormLabel}"/>
      <TextBox Grid.Column="1"
               Text="{Binding GigaAmDecoderFileName, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource FormField}"/>
    </Grid>

    <Grid Grid.Row="15" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Файл джойнера" Style="{StaticResource FormLabel}"/>
      <TextBox Grid.Column="1"
               Text="{Binding GigaAmJoinerFileName, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource FormField}"/>
    </Grid>

    <Grid Grid.Row="16" Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Файл токенов" Style="{StaticResource FormLabel}"/>
      <TextBox Grid.Column="1"
               Text="{Binding GigaAmTokensFileName, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource FormField}"/>
    </Grid>

    <!-- Spacer -->
    <Border Grid.Row="17"/>

    <!-- Footer buttons -->
    <Border Grid.Row="18"
            Padding="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="{Binding DownloadStatus}"
                   Visibility="{Binding DownloadStatus, Converter={StaticResource NullToVis}}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>
        <TextBlock Text="{Binding SummaryDownloadStatus}"
                   Visibility="{Binding SummaryDownloadStatus, Converter={StaticResource NullToVis}}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>
        <Button Content="Отмена"
                IsCancel="True"
                Style="{StaticResource SecondaryButton}"
                Margin="0,0,8,0"/>
        <Button Content="Сохранить"
                IsDefault="True"
                Command="{Binding SaveCommand}"
                Style="{StaticResource PrimaryButton}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
