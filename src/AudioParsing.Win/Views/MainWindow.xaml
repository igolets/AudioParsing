<Window x:Class="AudioParsing.Win.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioParsing" Width="720" Height="480" MinWidth="560" MinHeight="360"
        ResizeMode="CanResize" AllowDrop="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        DragOver="OnDragOver" Drop="OnDrop">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Grid.Row="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: status + cancel -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot"
                   Width="8" Height="8"
                   Fill="{StaticResource AccentBrush}"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"/>
          <TextBlock Text="Готово к работе"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     VerticalAlignment="Center"
                     Visibility="{Binding IsDropZoneVisible, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="Обработка…"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0"
                     Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"/>
          <Button Content="Отмена"
                  Style="{StaticResource DangerButton}"
                  Command="{Binding CancelCommand}"
                  Padding="12,5"
                  Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- Right: settings -->
        <Button Grid.Column="2"
                Content="Настройки"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding OpenSettingsCommand}"
                Padding="12,5"
                VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- Indeterminate progress bar during processing -->
    <ProgressBar Grid.Row="1"
                 IsIndeterminate="True"
                 Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"/>

    <!-- Drop zone (visible when idle). Click opens the multi-select file dialog. -->
    <Border Grid.Row="2" Margin="16"
            BorderThickness="2"
            BorderBrush="{StaticResource AccentLightBrush}"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="10"
            Cursor="Hand"
            Focusable="True"
            ToolTip="Нажмите, чтобы выбрать файлы"
            Visibility="{Binding IsDropZoneVisible, Converter={StaticResource BoolToVis}}">
      <Border.InputBindings>
        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectFilesCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding SelectFilesCommand}"/>
        <KeyBinding Key="Space" Command="{Binding SelectFilesCommand}"/>
      </Border.InputBindings>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Upload icon -->
        <Border Width="64" Height="64" CornerRadius="16"
                Background="{StaticResource AccentSubtleBrush}"
                HorizontalAlignment="Center" Margin="0,0,0,16">
          <TextBlock Text="⬆" FontSize="28"
                     Foreground="{StaticResource AccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBlock Text="Перетащите файлы сюда"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>

        <TextBlock Text="Поддерживаются аудио и видео форматы"
                   FontSize="13"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,4,0,0"/>

        <TextBlock Text="или нажмите, чтобы выбрать файлы"
                   FontSize="13"
                   Foreground="{StaticResource AccentBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,8,0,0"/>
      </StackPanel>
    </Border>

    <!-- Log (visible while processing and after completion) -->
    <Border Grid.Row="2" Margin="16"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVis}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Padding="4,8">
        <ItemsControl ItemsSource="{Binding Log}" Margin="12,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="8,6" CornerRadius="4" Margin="0,1">
                <!-- Level colors: ok → green, fail → red, skip → amber, info → blue, stages → muted -->
                <TextBlock Text="{Binding Display}" TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                      <Setter Property="FontSize" Value="12"/>
                      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="ok">
                          <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="fail">
                          <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="skip">
                          <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="info">
                          <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
